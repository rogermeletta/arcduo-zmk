/ {
    behaviors {
        // Function-key hold-taps used on the NUM layer (hold F1, tap 1).
        //
        // Deliberately WITHOUT hold-while-undecided: the hold here is a
        // function key, not a modifier, and pressing F1 speculatively on
        // every key-down would fire "help" in a lot of applications.
        hm: homerow_mod {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <190>; // triggers the hold behavior when the tapping-term-ms has expired
            quick-tap-ms = <175>; // If you press a tapped hold-tap again within quick-tap-ms milliseconds of the first press, it will always trigger the tap behavior.
            require-prior-idle-ms = <150>; // like quick-tap-ms however it will apply for any non-modifier key pressed before it
            bindings = <&kp>, <&kp>;  // hold, tap
        };

        // Home-row modifiers.
        //
        // hold-while-undecided presses the modifier immediately on key-down
        // and releases it again if the key resolves into a tap. Without it,
        // the modifier is only sent once the hold is decided -- which never
        // happens for a mouse click, because a click is not a key event. On
        // a keyboard with two integrated trackballs that meant Cmd-click and
        // Shift-click simply did not work.
        //
        // Caveat: for a position that also participates in a combo, the hold
        // is delayed until the combo timeout expires. That applies to F (13)
        // and J (16), which are in the CapsWord/paren/click combos. A (10)
        // and ; (19) -- the Cmd mods -- are combo-free and so are immediate.
        hmr: homerow_mod_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <190>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <0 1 2 3 4 10 11 12 13 14 20 21 22 23 24 30 31 32>;
            hold-trigger-on-release;
            hold-while-undecided;
        };

        hml: homerow_mod_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <190>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <5 6 7 8 9 15 16 17 18 19 25 26 27 28 29 33 34 35>;
            hold-trigger-on-release;
            hold-while-undecided;
        };

        // Hold gives EXTRAS, not NAV. NAV moved to the left inner thumb
        // (position 32) because that is how the UHK is held: the Mod key is a
        // left thumb key there, and its layer puts window and tab management
        // under the left fingers with the arrows under the right hand. Holding
        // NAV with the right thumb meant driving the arrows with the same hand
        // that was holding the layer down.
        td_space: td_space {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <85>;
            bindings = <&lt 4 SPACE>, <&kp SPACE>; // hold, tap, double_tap
        };

        td_bs: td_bs {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <85>;
            bindings = <&lt 1 BACKSPACE>, <&kp BACKSPACE>; // hold, tap, double_tap
        };

        td_tab: td_tab {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <85>;
            bindings = <&lt 1 TAB>, <&kp TAB>; // hold, tap, double_tap
        };

        td_bore: BASE_or_EXTRA {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            bindings = <&mo 4>, <&to 0>;
        };

        td_grave: DoubleTap_Grave {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            bindings = <&kp GRAVE>, <&grave_macro>;
        };

        td_hyphen: DoubleTap_Hyphen {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            bindings = <&kp MINUS>, <&minus_macro>;
        };

        td_equals: DoubleTap_Equals {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            bindings = <&kp EQUAL>, <&equals_macro>;
        };

        // Removed as dead code (recoverable from git history):
        //   td_cursor, td_clk_scrl  - both targeted layers 8 and 9, which
        //                             have never existed in this keymap
        //   td_esc, httl, td_layers - defined but never bound
        //   td_home                 - never bound; its grave_macro sibling
        //                             home_macro went with it
    };
};
